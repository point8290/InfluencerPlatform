# Copy to analytics/.env. Never commit real values.

ENVIRONMENT=development

# Must equal backend/.env JWT_SECRET: the analytics API verifies the backend's tokens.
JWT_SECRET=replace-me-with-the-backend-secret

# ── Kafka ──────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9094
KAFKA_TOPIC_PREFIX=platform
KAFKA_CONSUMER_GROUP=analytics-snowflake-loader

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_S=300

# ── Snowflake ──────────────────────────────────────────────────────────────
# Account identifier, e.g. myorg-myaccount
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_DATABASE=INFLUENCER_ANALYTICS
SNOWFLAKE_WAREHOUSE=ANALYTICS_WH
SNOWFLAKE_LOADER_USER=ANALYTICS_LOADER_SVC
SNOWFLAKE_LOADER_ROLE=ANALYTICS_LOADER
SNOWFLAKE_LOADER_WAREHOUSE=INGEST_WH
SNOWFLAKE_API_USER=ANALYTICS_API_SVC
# Key-pair auth (both service users are TYPE = SERVICE: no passwords).
SNOWFLAKE_PRIVATE_KEY_PATH=./secrets/snowflake_rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# ── Dashboard ──────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:4000
ANALYTICS_API_URL=http://localhost:8000
