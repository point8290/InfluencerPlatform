# Copy to backend/.env and fill in. .env is gitignored — never commit real keys.

NODE_ENV=development
PORT=4000

# Where the React app runs. Used for CORS and for Stripe's success/cancel URLs.
FRONTEND_URL=http://localhost:5173

# ── MySQL ────────────────────────────────────────────────────────────────
# The values below target the Dockerised MySQL:
#
#   docker compose up -d mysql
#
# It publishes on host port 3307 (not 3306) so it coexists with any MySQL you
# already have installed locally, and both databases are created for you by
# docker/mysql/init.sql on first start.
#
# Running the whole stack instead (`docker compose up`)? These are ignored —
# Compose supplies DB_HOST=mysql and DB_PORT=3306 as real environment
# variables, and dotenv does not overwrite variables that are already set.
#
# Using your own local MySQL rather than Docker? Set DB_PORT=3306, use your own
# password, and create both databases by hand:
#   CREATE DATABASE credits_wallet;
#   CREATE DATABASE credits_wallet_test;
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=credits_wallet
DB_NAME_TEST=credits_wallet_test
DB_USER=root
DB_PASSWORD=devroot

# ── Auth ─────────────────────────────────────────────────────────────────
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Stripe (test mode) ───────────────────────────────────────────────────
# Not required until step 4. The server starts without them; they are
# asserted at first use so steps 1-3 can run before you have keys wired.
#
# Secret key: Stripe Dashboard → Developers → API keys (must be sk_test_…)
STRIPE_SECRET_KEY=
# Webhook signing secret printed by:
#   stripe listen --forward-to localhost:4000/api/webhooks/stripe
# Note this is the CLI's secret and differs from a Dashboard endpoint secret.
STRIPE_WEBHOOK_SECRET=
